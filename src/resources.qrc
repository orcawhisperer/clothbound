    <qresource prefix="/">
        <file alias="Main.qml">Main.qml</file>
        <file alias="LibraryView.qml">LibraryView.qml</file>
        <file alias="BookCard.qml">BookCard.qml</file>
        <file alias="BookDetails.qml">BookDetails.qml</file>
        <file alias="ContinueShelf.qml">ContinueShelf.qml</file>
        <file alias="CoverImage.qml">CoverImage.qml</file>
        <file alias="EmptyLibrary.qml">EmptyLibrary.qml</file>
        <file alias="GeneratedCover.qml">GeneratedCover.qml</file>
        <file alias="Glyph.qml">Glyph.qml</file>
        <file alias="HelpOverlay.qml">HelpOverlay.qml</file>
        <file alias="IconButton.qml">IconButton.qml</file>
        <file alias="MenuRow.qml">MenuRow.qml</file>
        <file alias="SearchBox.qml">SearchBox.qml</file>
        <file alias="TextButton.qml">TextButton.qml</file>
        <file alias="Toast.qml">Toast.qml</file>
        <file alias="Format.js">Format.js</file>
        <file alias="Icons.js">Icons.js</file>
        <file alias="Ui.js">Ui.js</file>
        <file alias="dogear.svg">../pkgbuild/dogear.svg</file>
        <file alias="skill.md">skill.md</file>
        <file alias="fonts/Literata.ttf">fonts/Literata.ttf</file>
        <file alias="fonts/Literata-Italic.ttf">fonts/Literata-Italic.ttf</file>
        <file alias="i18n/en.json">i18n/en.json</file>
    </qresource>
</RCC>
