#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

SANITIZER=""
FUZZ_MODE=0
case "${1:-}" in
    --asan)
        SANITIZER="asan"
        shift
        ;;
    --tsan)
        SANITIZER="tsan"
        shift
        ;;
    --fuzz)
        FUZZ_MODE=1
        shift
        ;;
esac

if [ "$FUZZ_MODE" -eq 1 ]; then
    BUILD_DIR="$ROOT/build/tests-fuzz"
else
    case "$SANITIZER" in
        asan)
            BUILD_DIR="$ROOT/build/tests-asan"
            ;;
        tsan)
            BUILD_DIR="$ROOT/build/tests-tsan"
            ;;
        *)
            BUILD_DIR="$ROOT/build/tests"
            ;;
    esac
fi

if command -v ninja >/dev/null 2>&1; then
    GENERATOR="Ninja"
else
    GENERATOR="Unix Makefiles"
fi

# Clear stale qmake files or mismatched CMake generator caches.
if [ -f "$BUILD_DIR/.qmake.stash" ]; then
    rm -rf "$BUILD_DIR/Makefile" "$BUILD_DIR/.qmake.stash" "$BUILD_DIR/.stamp" \
        "$BUILD_DIR"/*.o "$BUILD_DIR"/moc_* "$BUILD_DIR"/qrc_* "$BUILD_DIR"/ui_*
fi
if [ -f "$BUILD_DIR/CMakeCache.txt" ]; then
    CACHED_GEN="$(sed -n 's/^CMAKE_GENERATOR:INTERNAL=//p' "$BUILD_DIR/CMakeCache.txt" | head -n 1)"
    if [ -n "$CACHED_GEN" ] && [ "$CACHED_GEN" != "$GENERATOR" ]; then
        rm -rf "$BUILD_DIR/CMakeCache.txt" "$BUILD_DIR/CMakeFiles"
    fi
fi

if [ "$FUZZ_MODE" -eq 1 ]; then
    TEST_HOME="$(mktemp -d "${TMPDIR:-/tmp}/clothbound-fuzz.XXXXXX")"
    trap 'rm -rf "$TEST_HOME"' EXIT INT TERM

    if ! command -v clang++ >/dev/null 2>&1; then
        echo "Skipping --fuzz: clang++ is not installed." >&2
        exit 0
    fi

    cat > "$TEST_HOME/probe.cpp" <<'EOF'
#include <cstddef>
#include <cstdint>
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *, size_t) { return 0; }
EOF
    if ! clang++ -fsanitize=fuzzer,address,undefined "$TEST_HOME/probe.cpp" -o "$TEST_HOME/probe" >/dev/null 2>&1; then
        echo "Skipping --fuzz: Clang libFuzzer runtime (libclang_rt.fuzzer) is not installed." >&2
        exit 0
    fi

    cmake -S "$ROOT" -B "$BUILD_DIR" \
        -G "$GENERATOR" \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_BUILD_TYPE=Release \
        -DCLOTHBOUND_BUILD_TESTS=ON \
        -DCLOTHBOUND_BUILD_FUZZERS=ON \
        -DCLOTHBOUND_FORCE_ASSERTS=ON \
        -DCLOTHBOUND_SANITIZER=asan

    cmake --build "$BUILD_DIR" --parallel "$(nproc)" --target clothbound_fuzzers

    export QT_QPA_PLATFORM=offscreen
    export QT_QPA_PLATFORMTHEME=generic
    export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:halt_on_error=1}"
    export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"

    FUZZ_SECONDS="${CLOTHBOUND_FUZZ_SECONDS:-2}"
    mkdir -p "$TEST_HOME/artifacts" "$TEST_HOME/corpus"

    TARGETS="fuzz_ziparchive fuzz_htmltokenizer fuzz_opdsparser fuzz_articleextractor fuzz_mathformatter fuzz_sseparser"
    for target in $TARGETS; do
        mkdir -p "$TEST_HOME/corpus/$target"
        echo "=== Running $target (-max_total_time=$FUZZ_SECONDS) ==="
        "$BUILD_DIR/fuzz/$target" \
            "$TEST_HOME/corpus/$target" \
            -max_total_time="$FUZZ_SECONDS" \
            -artifact_prefix="$TEST_HOME/artifacts/${target}-" \
            "$@"
    done
    exit 0
fi

cmake -S "$ROOT" -B "$BUILD_DIR" \
    -G "$GENERATOR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCLOTHBOUND_BUILD_TESTS=ON \
    -DCLOTHBOUND_FORCE_ASSERTS=ON \
    -DCLOTHBOUND_SANITIZER="$SANITIZER"

if [ "$SANITIZER" = "tsan" ]; then
    cmake --build "$BUILD_DIR" --parallel "$(nproc)" --target tst_concurrency tst_w8_storage_palette
else
    cmake --build "$BUILD_DIR" --parallel "$(nproc)" --target \
        clothbound_tests tst_concurrency tst_webengine_e2e \
        tst_w8_storage_palette tst_w8_passage_quant tst_w8_mcp_cli \
        clothbound-mcp
fi

TEST_HOME="$(mktemp -d "${TMPDIR:-/tmp}/clothbound-test.XXXXXX")"
trap 'rm -rf "$TEST_HOME"' EXIT INT TERM
mkdir -p "$TEST_HOME/config" "$TEST_HOME/data" "$TEST_HOME/cache"

export XDG_CONFIG_HOME="$TEST_HOME/config"
export XDG_DATA_HOME="$TEST_HOME/data"
export XDG_CACHE_HOME="$TEST_HOME/cache"
export QT_QPA_PLATFORM=offscreen
export QT_QPA_PLATFORMTHEME=generic
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---no-sandbox --disable-gpu --disable-dev-shm-usage}"
export CLOTHBOUND_MCP_BIN="$BUILD_DIR/clothbound-mcp"

if [ "$SANITIZER" = "asan" ]; then
    export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"
    export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"
elif [ "$SANITIZER" = "tsan" ]; then
    export TSAN_OPTIONS="${TSAN_OPTIONS:-suppressions=$ROOT/tests/tsan.supp:ignore_noninstrumented_modules=1:report_thread_leaks=0:halt_on_error=1}"
fi

run_in_session() {
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- "$@"
    else
        "$@"
    fi
}

cd "$BUILD_DIR"
if [ "$SANITIZER" = "tsan" ]; then
    if [ "$#" -gt 0 ]; then
        run_in_session ./tst_concurrency "$@"
    else
        run_in_session ./tst_concurrency
        run_in_session ./tst_w8_storage_palette
    fi
elif [ "$#" -gt 0 ]; then
    run_in_session ./clothbound_tests "$@"
else
    run_in_session ./clothbound_tests
    run_in_session ./tst_concurrency
    run_in_session ./tst_webengine_e2e
    run_in_session ./tst_w8_storage_palette
    run_in_session ./tst_w8_passage_quant
    run_in_session ./tst_w8_mcp_cli
fi
