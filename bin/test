#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

qmake6 "$ROOT/tests/clothbound_tests.pro"
make -j"$(nproc)"

TEST_HOME="$(mktemp -d "${TMPDIR:-/tmp}/clothbound-test.XXXXXX")"
trap 'rm -rf "$TEST_HOME"' EXIT INT TERM
mkdir -p "$TEST_HOME/config" "$TEST_HOME/data" "$TEST_HOME/cache"

XDG_CONFIG_HOME="$TEST_HOME/config" \
XDG_DATA_HOME="$TEST_HOME/data" \
XDG_CACHE_HOME="$TEST_HOME/cache" \
QT_QPA_PLATFORM=offscreen \
QT_QPA_PLATFORMTHEME=generic \
./clothbound_tests "$@"
