#!/usr/bin/env python3
"""Clothbound's translations, kept up to date with Gemini.

    bin/translate extract            list the strings to translate (and how many each language lacks)
    bin/translate check [--strict]   validate all catalogs offline (report missing/orphan keys; --strict fails on drift)
    bin/translate prune [--dry-run]  losslessly remove orphan keys absent from extracted strings across all catalogs
    bin/translate [code ...]         translate what's missing into these languages (all of Omarchy's by default)

Strings come from qsTr() in the QML and JS, tr(), translate(), and QT_TR_NOOP()
in the C++, and the .desktop entry. Each language's catalog is
src/i18n/<code>.json: English text to its translation, or, for a counted string
(%n/%Ln), an object of the language's plural forms (always including "other").
Only what's missing or malformed is sent, so running it again after a change
costs a few cents. It needs GEMINI_API_KEY in the environment.
"""

import json
import os
import re
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "src"
I18N = SRC / "i18n"
LOCALES = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "default/i18n/locales.json"
MODEL = os.environ.get("CLOTHBOUND_TRANSLATE_MODEL") or os.environ.get("DOGEAR_TRANSLATE_MODEL", "gemini-3.5-flash-lite")

# CLDR plural categories each language uses (always including "other" as fallback
# for Translator::translate()).
PLURALS = {
    "ja": ["other"], "ko": ["other"], "zh-CN": ["other"], "zh-TW": ["other"], "th": ["other"], "vi": ["other"],
    "id": ["other"], "ms": ["other"], "fr": ["one", "many", "other"], "pt-BR": ["one", "many", "other"],
    "ca": ["one", "many", "other"], "es": ["one", "many", "other"], "es-MX": ["one", "many", "other"],
    "it": ["one", "many", "other"], "pt": ["one", "many", "other"], "cs": ["one", "few", "other"],
    "sk": ["one", "few", "other"], "pl": ["one", "few", "many", "other"], "ru": ["one", "few", "many", "other"],
    "uk": ["one", "few", "many", "other"], "hr": ["one", "few", "other"], "sr": ["one", "few", "other"],
    "sl": ["one", "two", "few", "other"], "lt": ["one", "few", "other"], "lv": ["zero", "one", "other"],
    "ro": ["one", "few", "other"], "ar": ["zero", "one", "two", "few", "many", "other"],
    "he": ["one", "two", "other"], "ga": ["one", "two", "few", "many", "other"],
}

LITERAL = r'"((?:[^"\\]|\\.)*)"'
PLACEHOLDER = re.compile(r"%L?[0-9n]")
HTML_TAG = re.compile(r"</?([a-zA-Z0-9]+)(?:\s[^>]*)?>")
# Categories where omitting %n/%Ln in exact single-value forms is valid only for
# languages whose pluralCategory maps them to exact 0, 1, or 2.
EXACT_NUMBER_FORMS = {
    "ar": {"zero", "one", "two"},
    "he": {"one", "two"},
    "ro": {"one"},
    "ga": {"one", "two"},
}


def unescape(text):
    return json.loads('"' + text + '"')


def extract():
    """{english: plural?} for every visible string."""
    strings = {}
    qml = re.compile(r"qsTr\(\s*" + LITERAL + r"(\s*,\s*" + LITERAL + r"\s*,)?")
    for path in sorted(list(SRC.rglob("*.qml")) + list(SRC.rglob("*.js"))):
        for match in qml.finditer(path.read_text()):
            text = unescape(match.group(1))
            strings[text] = strings.get(text, False) or bool(match.group(2)) or "%n" in text or "%Ln" in text
    # C++: tr("…"), translate("Context", "…"), and QT_TR_NOOP("…"), with adjacent literals joined.
    joined = r'((?:"(?:[^"\\]|\\.)*"\s*)+)'
    cpp = re.compile(r"\btr\(\s*" + joined + r"|translate\(\s*" + LITERAL + r"\s*,\s*" + joined + r"|QT_TR_NOOP\(\s*" + joined)
    for path in sorted(list(SRC.rglob("*.cpp")) + list(SRC.rglob("*.h"))):
        for match in cpp.finditer(path.read_text()):
            raw = match.group(1) or match.group(3) or match.group(4)
            text = "".join(unescape(part) for part in re.findall(LITERAL, raw))
            if text:
                strings[text] = strings.get(text, False) or "%n" in text or "%Ln" in text
    return strings


def placeholders(text):
    return sorted(PLACEHOLDER.findall(text))


def normalize_count_placeholders(ph_list):
    """Treat %n and %Ln as equivalent count placeholders when validating."""
    return sorted("%n" if p in ("%n", "%Ln") else p for p in ph_list)


def valid_form(code, source, translated, form=None):
    if not isinstance(translated, str) or not translated.strip():
        return False
    if sorted(HTML_TAG.findall(source)) != sorted(HTML_TAG.findall(translated)):
        return False
    exp = normalize_count_placeholders(placeholders(source))
    got = normalize_count_placeholders(placeholders(translated))
    if got == exp:
        return True
    if form and form in EXACT_NUMBER_FORMS.get(code, set()):
        exp_no_n = [p for p in exp if p != "%n"]
        got_no_n = [p for p in got if p != "%n"]
        return got_no_n == exp_no_n and "%n" not in got
    return False


def is_valid_entry(code, text, counted, value):
    forms = PLURALS.get(code, ["one", "other"])
    if counted:
        if not isinstance(value, dict):
            return False
        if "other" not in value:
            return False
        for form in forms:
            if form not in value or not valid_form(code, text, value[form], form=form):
                return False
        return True
    return valid_form(code, text, value)


def catalog(code):
    path = I18N / f"{code}.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}


def format_catalog(entries, raw=None):
    """Serialize a catalog preserving existing indentation (or compact sorted JSON) in UTF-8."""
    ordered = dict(sorted(entries.items()))
    if raw is not None:
        lines = raw.splitlines()
        if len(lines) > 1:
            indent = None
            for line in lines[1:]:
                stripped = line.lstrip(" \t")
                if stripped and stripped != "}":
                    prefix = line[: len(line) - len(stripped)]
                    if prefix:
                        indent = len(prefix) if prefix.strip(" ") == "" else prefix
                        break
            if indent is not None:
                trailing = "\n" if raw.endswith("\n") else ""
                return json.dumps(ordered, ensure_ascii=False, indent=indent) + trailing
    return json.dumps(ordered, ensure_ascii=False, separators=(",", ":")) + "\n"


def save(code, entries):
    I18N.mkdir(exist_ok=True)
    (I18N / f"{code}.json").write_text(format_catalog(entries), encoding="utf-8")


SCHEMA = {
    "type": "ARRAY",
    "items": {
        "type": "OBJECT",
        "properties": {
            "i": {"type": "INTEGER"},
            "translation": {"type": "STRING"},
            "forms": {"type": "OBJECT", "properties": {form: {"type": "STRING"} for form in
                                                         ("zero", "one", "two", "few", "many", "other")}},
        },
        "required": ["i"],
    },
}


def ask(prompt):
    """The model's answers, by entry number: {i: {"translation": …} or {"forms": …}}."""
    key = os.environ.get("GEMINI_API_KEY", "").strip()
    if not key:
        sys.exit("Set GEMINI_API_KEY to translate.")
    body = {
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {"responseMimeType": "application/json", "responseSchema": SCHEMA, "temperature": 0.2},
    }
    for attempt in range(3):
        request = urllib.request.Request(
            f"https://generativelanguage.googleapis.com/v1beta/models/{MODEL}:generateContent",
            data=json.dumps(body).encode(), headers={"Content-Type": "application/json", "x-goog-api-key": key})
        try:
            with urllib.request.urlopen(request, timeout=300) as response:
                answer = json.load(response)
            parts = answer["candidates"][0]["content"]["parts"]
            items = json.loads("".join(part.get("text", "") for part in parts))
            return {item["i"]: item for item in items if isinstance(item, dict) and "i" in item}
        except (ValueError, KeyError, OSError) as error:
            print(f"  (trying again: {error})", flush=True)
    return {}


def translate(code, name, strings, existing):
    missing = [text for text, counted in strings.items()
               if text not in existing or not is_valid_entry(code, text, counted, existing[text])]
    if not missing:
        return existing, 0
    forms = PLURALS.get(code, ["one", "other"])
    done = dict(existing)
    for start in range(0, len(missing), 100):
        batch = missing[start:start + 100]
        listed = [{"i": i, "text": text, "counted": strings[text]} for i, text in enumerate(batch)]
        prompt = f"""Translate the interface text of Clothbound, an ebook reader and audiobook app for the Omarchy desktop, into {name} ({code}).

Rules:
- Natural, friendly, concise {name}, as a native speaker would write a well-made desktop app; keep the same tone (plain, warm, no jargon).
- Keep placeholders exactly: %1, %2, %n, %Ln, and keep HTML tags, URLs, and keyboard keys (P, ⇧, Ctrl, Esc, Super W) as they are.
- Keep brand and product names as they are: Clothbound, Omarchy, Gemini, Google, Kokoro, Piper, Ollama, llama.cpp, LM Studio, MLX, vLLM, EPUB, PDF, M4B, MPRIS.
- For an entry with "counted": true, give "forms": the plural forms {name} uses ({", ".join(forms)}), ALWAYS including "other", each containing %n (or %Ln) where the number goes. Otherwise give "translation".

Answer with a JSON array: for each entry, its "i" and its translation.

{json.dumps(listed, ensure_ascii=False, indent=0)}"""
        answer = ask(prompt)
        for i, text in enumerate(batch):
            item = answer.get(i, {})
            value, plural = item.get("translation"), item.get("forms")
            if strings[text]:
                if isinstance(plural, dict):
                    # Never fabricate "other" from exact-singular/dual forms ("one"/"two"/"zero").
                    fallback = plural.get("other") or plural.get("many")
                    if fallback and valid_form(code, text, fallback, form="other"):
                        built = {}
                        for form in forms:
                            candidate = plural.get(form)
                            built[form] = candidate if valid_form(code, text, candidate, form=form) else fallback
                        if is_valid_entry(code, text, True, built):
                            done[text] = built
                            continue
                if isinstance(value, str) and valid_form(code, text, value, form="other"):
                    done[text] = {form: value for form in forms}
            elif isinstance(value, str) and valid_form(code, text, value):
                done[text] = value
        print(f"  {code}: {min(start + 100, len(missing))} of {len(missing)}", flush=True)
    return done, len(missing)


def english(strings):
    """English plural forms, so "%n models" reads "1 model"."""
    entries = catalog("en")
    counted = [text for text, plural in strings.items()
               if plural and (text not in entries or not is_valid_entry("en", text, True, entries[text]))]
    if counted:
        listed = [{"i": i, "text": text} for i, text in enumerate(counted)]
        answer = ask("For each English interface string below, give \"forms\" with its \"one\" (singular) and "
                     "\"other\" (plural) forms, keeping %n, %Ln, %1 and %2. Answer with a JSON array: for each "
                     "entry, its \"i\" and \"forms\".\n\n" + json.dumps(listed))
        for i, text in enumerate(counted):
            forms = answer.get(i, {}).get("forms") or {}
            if forms.get("other") and valid_form("en", text, forms["other"], form="other"):
                one = forms.get("one") if valid_form("en", text, forms.get("one"), form="one") else forms["other"]
                entries[text] = {"one": one, "other": forms["other"]}
    save("en", {text: value for text, value in entries.items() if text == "_meta" or strings.get(text)})


def prune(strings, dry_run=False):
    """Losslessly remove orphan keys absent from extracted strings across all catalogs."""
    catalog_paths = sorted(I18N.glob("*.json"))
    total_removed = 0
    total_bytes_before = 0
    total_bytes_after = 0
    touched = 0

    for path in catalog_paths:
        code = path.stem
        raw = path.read_text(encoding="utf-8")
        try:
            entries = json.loads(raw)
        except ValueError as err:
            print(f"{code}: invalid JSON: {err}", file=sys.stderr)
            return 1
        if not isinstance(entries, dict):
            print(f"{code}: top-level JSON value must be an object", file=sys.stderr)
            return 1

        if code == "en":
            pruned = {k: v for k, v in entries.items() if k == "_meta" or strings.get(k)}
        else:
            pruned = {k: v for k, v in entries.items() if k == "_meta" or k in strings}

        removed = len(entries) - len(pruned)
        before = len(raw.encode("utf-8"))
        serialized = format_catalog(pruned, raw=raw) if removed else raw
        after = len(serialized.encode("utf-8"))
        total_removed += removed
        total_bytes_before += before
        total_bytes_after += after
        if removed:
            touched += 1
            if not dry_run:
                path.write_text(serialized, encoding="utf-8")
            print(f"  {code}: pruned {removed} orphan key(s) ({after - before:+d} bytes -> {after} bytes)")

    saved = total_bytes_before - total_bytes_after
    pct = (100.0 * saved / total_bytes_before) if total_bytes_before else 0.0
    verb = "Would prune" if dry_run else "Pruned"
    print(
        f"{verb} {total_removed} orphan key(s) across {touched}/{len(catalog_paths)} catalogs "
        f"({total_bytes_before} -> {total_bytes_after} bytes, saved {saved} bytes / {pct:.2f}%)."
    )
    return 0


def check(strings, strict=False):
    """Offline validation of all catalogs, with missing/orphan key reporting."""
    errors = []
    locale_stats = []
    en_path = I18N / "en.json"
    en = {}
    if en_path.exists():
        try:
            en = json.loads(en_path.read_text(encoding="utf-8"))
        except ValueError as err:
            errors.append(f"en: invalid JSON: {err}")
    for text, counted in sorted(strings.items()):
        if counted and (text not in en or not is_valid_entry("en", text, True, en[text])):
            errors.append(f"en: missing or invalid plural entry for {text!r}")
    for text, value in en.items():
        if text == "_meta":
            continue
        if not is_valid_entry("en", text, True, value):
            errors.append(f"en: invalid plural entry for {text!r}: {value!r}")
    en_missing = sum(1 for text, counted in strings.items() if counted and text not in en)
    en_orphans = sum(1 for text in en if text != "_meta" and (text not in strings or not strings[text]))
    locale_stats.append(("en", en_missing, en_orphans))

    catalog_paths = sorted(I18N.glob("*.json"))
    for path in catalog_paths:
        code = path.stem
        if code == "en":
            continue
        try:
            entries = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as err:
            errors.append(f"{code}: invalid JSON: {err}")
            continue
        if not isinstance(entries, dict):
            errors.append(f"{code}: top-level JSON value must be an object")
            continue
        for text, value in entries.items():
            if text == "_meta":
                continue
            counted = strings.get(text, "%n" in text or "%Ln" in text)
            if not is_valid_entry(code, text, counted, value):
                errors.append(f"{code}: invalid entry for {text!r}: {value!r}")
        missing = sum(1 for text in strings if text not in entries)
        orphans = sum(1 for text in entries if text != "_meta" and text not in strings)
        locale_stats.append((code, missing, orphans))

    for code, missing, orphans in locale_stats:
        print(f"  {code}: {missing} missing, {orphans} orphan")

    total_missing = sum(m for _, m, _ in locale_stats)
    total_orphans = sum(o for _, _, o in locale_stats)
    locales_with_missing = sum(1 for _, m, _ in locale_stats if m > 0)
    locales_with_orphans = sum(1 for _, _, o in locale_stats if o > 0)
    non_en_stats = [(c, m, o) for c, m, o in locale_stats if c != "en"]
    max_missing = max((m for _, m, _ in non_en_stats), default=0)
    max_orphans = max((o for _, _, o in non_en_stats), default=0)

    print(
        f"Summary: checked {len(catalog_paths)} catalogs against {len(strings)} extracted strings "
        f"({locales_with_missing} locales missing keys, up to {max_missing} missing / "
        f"{total_missing} total; {locales_with_orphans} locales with orphan keys, up to "
        f"{max_orphans} orphan / {total_orphans} total)."
    )

    if errors:
        for err in errors:
            print(err, file=sys.stderr)
        return 1

    if total_missing or total_orphans:
        msg = (
            f"i18n drift detected: {locales_with_missing} locale(s) missing up to {max_missing} "
            f"keys ({total_missing} total), {locales_with_orphans} locale(s) with up to "
            f"{max_orphans} orphan keys ({total_orphans} total)."
        )
        if strict:
            print(f"ERROR: {msg} (--strict enabled)", file=sys.stderr)
            return 1
        print(f"WARNING: {msg} Run `bin/translate` to update catalogs or pass `--strict` to fail.", file=sys.stderr)
        return 0

    print(f"Checked {len(catalog_paths)} catalogs: all entries valid and up to date.")
    return 0


def register(codes):
    """Keep only the English fallback embedded in resources.qrc (non-English
    catalogs load lazily from disk), and update the translated launcher entry."""
    qrc = SRC / "resources.qrc"
    text = qrc.read_text()
    en_line = '        <file alias="i18n/en.json">i18n/en.json</file>\n'
    text = re.sub(r'(        <file alias="i18n/[^"]+">[^<]+</file>\n)+', lambda _: en_line, text)
    qrc.write_text(text)
    desktop = ROOT / "pkgbuild/clothbound.desktop"
    entry = [line for line in desktop.read_text().splitlines() if not re.match(r"^(Name|Comment|GenericName)\[", line)]
    keys = {"Name": "Clothbound", "GenericName": "Ebook Reader", "Comment": "Read your EPUB and PDF books"}
    out = []
    for line in entry:
        out.append(line)
        key = line.split("=", 1)[0]
        if key in keys:
            for code in sorted(codes):
                value = catalog(code).get(keys[key])
                if isinstance(value, str) and value != keys[key]:
                    out.append(f"{key}[{code.replace('-', '_')}]={value}")
    desktop.write_text("\n".join(out) + "\n")


def main():
    strings = extract()
    # The launcher's words too.
    for text in ("Ebook Reader", "Read your EPUB and PDF books"):
        strings.setdefault(text, False)
    locales = json.loads(LOCALES.read_text()) if LOCALES.exists() else {}
    if sys.argv[1:2] == ["extract"]:
        print(f"{len(strings)} strings, {sum(strings.values())} counted")
        for code in sorted(locales):
            if code != "en":
                cat = catalog(code)
                missing = [t for t, c in strings.items() if t not in cat or not is_valid_entry(code, t, c, cat[t])]
                print(f"  {code}: {len(missing)} to translate")
        return
    if sys.argv[1:2] == ["check"]:
        extra = sys.argv[2:]
        if extra and extra != ["--strict"]:
            sys.exit("Usage: bin/translate check [--strict]")
        sys.exit(check(strings, strict=("--strict" in extra)))
    if sys.argv[1:2] == ["prune"]:
        extra = sys.argv[2:]
        if extra and extra != ["--dry-run"]:
            sys.exit("Usage: bin/translate prune [--dry-run]")
        sys.exit(prune(strings, dry_run=("--dry-run" in extra)))
    codes = sys.argv[1:] or [code for code in locales if code != "en"]
    english(strings)
    for code in codes:
        name = locales.get(code, {}).get("englishName", code)
        entries, asked = translate(code, name, strings, catalog(code))
        # Strings no longer in the app are dropped.
        save(code, {text: value for text, value in entries.items() if text == "_meta" or text in strings})
        print(f"{code}: {asked} translated")
    register([code for code in locales if code != "en"])


if __name__ == "__main__":
    main()
